@model App.ViewModels.Auth.RegisterVM
{

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Register</title>

    
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>

        body {
            background: linear-gradient( 135deg, #0f172a, #2563eb);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
        }

        .register-card {
            width: 100%;
            max-width: 550px;
            border-radius: 25px;
            overflow: hidden;
        }

    </style>

</head>

<body>

    <div class="card shadow-lg border-0 register-card">

       
        <div class="bg-dark text-white text-center p-4">

            <h2 class="fw-bold">

                Create Account

            </h2>

            <p class="mb-0">

                Join the Library Management System

            </p>

        </div>


       
        <div class="card-body p-5">

            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">

                    @TempData["Success"]

                </div>
            }

           
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">

                    @TempData["Error"]

                </div>
            }


           
            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>


            <form asp-action="Register"
                  method="post">

                
                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Full Name

                    </label>

                    <input asp-for="Name"
                           class="form-control form-control-lg rounded-3" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                
                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Email

                    </label>

                    <input asp-for="Email"
                           class="form-control form-control-lg rounded-3" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                
                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Password

                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control form-control-lg rounded-3" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>


                
                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Confirm Password

                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control form-control-lg rounded-3" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>


               
                <button type="submit"
                        class="btn btn-dark btn-lg w-100 rounded-3 shadow">

                    Register

                </button>

            </form>


            
            <div class="text-center mt-4">

                <p>

                    Already have an account?

                    <a asp-action="Login"
                       class="fw-bold text-decoration-none">

                        Login

                    </a>

                </p>

            </div>

        </div>

    </div>


    
    <partial name="_ValidationScriptsPartial" />

</body>

</html>