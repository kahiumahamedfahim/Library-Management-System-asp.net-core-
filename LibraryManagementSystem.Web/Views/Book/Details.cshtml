@model Web.ViewModels.Book.BookDetailsVM

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-5">

    <div class="row">

        
        <div class="col-lg-4 mb-4">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         class="img-fluid"
                         style="height:500px; object-fit:cover;" />
                }
                else
                {
                    <div class="bg-secondary text-white d-flex justify-content-center align-items-center"
                         style="height:500px;">

                        <h3>No Image</h3>

                    </div>
                }

            </div>

        </div>


      
        <div class="col-lg-8">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-5">

             
                    <h1 class="fw-bold mb-3">

                        @Model.Title

                    </h1>


                
                    <div class="mb-4">

                        <span class="badge bg-dark fs-6 me-2">

                            @Model.CategoryName

                        </span>

                        @if (Model.Quantity > 0)
                        {
                            <span class="badge bg-success fs-6">

                                Available : @Model.Quantity

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">

                                Out Of Stock

                            </span>
                        }

                    </div>


                   
                    <div class="mb-4">

                        <h5 class="text-muted mb-2">
                            Author
                        </h5>

                        <h4 class="fw-semibold">

                            @Model.AuthorName

                        </h4>

                    </div>


                    
                    <div class="mb-5">

                        <h5 class="text-muted mb-3">
                            Description
                        </h5>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="fs-5 text-secondary"
                               style="line-height:1.8;">

                                @Model.Description

                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                No description available.
                            </p>
                        }

                    </div>


                 
                    <div class="d-flex gap-3 flex-wrap">

                       
                        @if (User.IsInRole("Admin") ||
                                                User.IsInRole("Librarian"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-warning btn-lg px-4">

                                Edit Book

                            </a>
                        }


                        
                        @if (User.IsInRole("Member") && Model.Quantity > 0)
                        {
                            <form asp-controller="Borrow"
                                  asp-action="BorrowBook"
                                  method="post">

                                <input type="hidden"
                                       name="bookId"
                                       value="@Model.Id" />

                                <button type="submit"
                                        class="btn btn-success btn-lg px-4">

                                    Borrow Book

                                </button>

                            </form>
                        }


                        
                        @if (User.IsInRole("Member") && Model.Quantity <= 0)
                        {
                            <button class="btn btn-secondary btn-lg px-4"
                                    disabled>

                                Out Of Stock

                            </button>
                        }


                       
                        <a asp-action="Index"
                           class="btn btn-outline-secondary btn-lg px-4">

                            Back To List

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>