@model Web.ViewModels.Book.BookCreateVM

@{
    ViewData["Title"] = "Create Book";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-lg rounded-4">

                
                <div class="card-header bg-primary text-white rounded-top-4 p-4">

                    <h2 class="fw-bold mb-1">
                        Add New Book
                    </h2>

                    <p class="mb-0">
                        Create a new library book
                    </p>

                </div>


            
                <div class="card-body p-5">

                   
                    <div asp-validation-summary="All"
                         class="alert alert-danger">
                    </div>


                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="row">

                            
                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">
                                    Book Title
                                </label>

                                <input asp-for="Title"
                                       class="form-control form-control-lg rounded-3" />

                                <span asp-validation-for="Title"
                                      class="text-danger">
                                </span>

                            </div>


                           
                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">
                                    Quantity
                                </label>

                                <input asp-for="Quantity"
                                       class="form-control form-control-lg rounded-3" />

                                <span asp-validation-for="Quantity"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                       
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      rows="4"
                                      class="form-control rounded-3">
                            </textarea>

                        </div>


                        <div class="row">

                           
                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">
                                    Author
                                </label>

                                <select asp-for="AuthorId"
                                        asp-items="Model.Authors"
                                        class="form-select form-select-lg rounded-3">

                                    <option value="">
                                        Select Author
                                    </option>

                                </select>

                                <span asp-validation-for="AuthorId"
                                      class="text-danger">
                                </span>

                            </div>


                            
                            <div class="col-md-6 mb-4">

                                <label class="form-label fw-semibold">
                                    Category
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="Model.Categories"
                                        class="form-select form-select-lg rounded-3">

                                    <option value="">
                                        Select Category
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                       
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Upload Book Image
                            </label>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control rounded-3"
                                   id="imageInput"
                                   accept="image/*" />

                        </div>


                        
                        <div class="mb-4 text-center">

                            <img id="previewImage"
                                 src="https://via.placeholder.com/200x250?text=Preview"
                                 class="img-fluid rounded shadow"
                                 style="max-height:250px; object-fit:cover;" />

                        </div>


                      
                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg px-4">

                                Back

                            </a>

                            <button type="submit"
                                    class="btn btn-primary btn-lg px-5 shadow">

                                Save Book

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const imageInput =
            document.getElementById("imageInput");

        const previewImage =
            document.getElementById("previewImage");

        imageInput.addEventListener("change", function (e) {

            const file = e.target.files[0];

            if (file)
            {
                previewImage.src =
                    URL.createObjectURL(file);
            }

        });

    </script>
}