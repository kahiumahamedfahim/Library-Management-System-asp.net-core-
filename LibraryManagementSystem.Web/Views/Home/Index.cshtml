@model List<DAL.EF.Table.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="container-fluid mt-4">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold">

                Library Books

            </h1>

            <p class="text-muted">

                Browse and manage library books

            </p>

        </div>


        
        @if (User.IsInRole("Admin") ||
                User.IsInRole("Librarian"))
        {
            <a asp-controller="Book"
                asp-action="Create"
               class="btn btn-primary btn-lg shadow-sm">

                + Add New Book

            </a>
        }

    </div>


    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="Index">

                <div class="row g-3 align-items-center">

                    @* <div class="col-md-10">

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Search by title, author or category..." />

                    </div> *@


                    @* <div class="col-md-2 d-grid">

                        <button type="submit"
                                class="btn btn-dark btn-lg rounded-3">

                            Search

                        </button>

                    </div> *@

                </div>

            </form>

        </div>

    </div>


    <!-- BOOK TABLE -->
    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Image</th>

                            <th>Title</th>

                            <th>Author</th>

                            <th>Category</th>

                            <th>Quantity</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var book in Model)
                        {
                            <tr>

                                <!-- IMAGE -->
                                <td>

                                    @if (!string.IsNullOrEmpty(book.ImageUrl))
                                    {
                                        <img src="@book.ImageUrl"
                                             width="70"
                                             height="90"
                                             class="rounded shadow-sm"
                                             style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white d-flex justify-content-center align-items-center rounded"
                                             style="width:70px; height:90px;">

                                            No Image

                                        </div>
                                    }

                                </td>


                                <!-- TITLE -->
                                <td>

                                    <h6 class="fw-bold mb-1">

                                        @book.Title

                                    </h6>

                                </td>


                                <!-- AUTHOR -->
                                <td>

                                    @book.Author.Name

                                </td>


                                <!-- CATEGORY -->
                                <td>

                                    <span class="badge bg-dark">

                                        @book.Category.Name

                                    </span>

                                </td>


                                <!-- QUANTITY -->
                                <td>

                                    @if (book.Quantity > 0)
                                    {
                                        <span class="badge bg-success fs-6">

                                            Available : @book.Quantity

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6">

                                            Out Of Stock

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-center">

                                    <!-- DETAILS -->
                                    <a asp-controller="Book" 
                                    asp-action="Details"
                                       asp-route-id="@book.Id"
                                       class="btn btn-info btn-sm text-white">

                                        Details

                                    </a>


                                    <!-- ADMIN / LIBRARIAN -->
                                    @if (User.IsInRole("Admin") ||
                                                                    User.IsInRole("Librarian"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@book.Id"
                                           class="btn btn-warning btn-sm">

                                            Edit

                                        </a>


                                        <form asp-action="Delete"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@book.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Delete this book?')">

                                                Delete

                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

}